# Writes OUT, a C++ source with the files of ROOT/FILES as byte arrays and
# lisbench::web::assets() listing them. Run with cmake -P at build time.
set(content "// Generated by cmake/embed.cmake from web/. Do not edit.\n")
string(APPEND content "#include \"lisbench/web/assets.hpp\"\n\n#include <array>\n\n")
string(APPEND content "namespace lisbench::web {\nnamespace {\n")
set(index 0)
set(entries "")
foreach(file IN LISTS FILES)
  file(READ "${ROOT}/${file}" hex HEX)
  string(LENGTH "${hex}" hex_length)
  math(EXPR size "${hex_length} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND content "constexpr std::array<unsigned char, ${size}> f${index}{${bytes}};\n")
  if(file MATCHES "\\.html$")
    set(type "text/html; charset=utf-8")
  elseif(file MATCHES "\\.css$")
    set(type "text/css; charset=utf-8")
  elseif(file MATCHES "\\.js$")
    set(type "text/javascript; charset=utf-8")
  else()
    set(type "application/octet-stream")
  endif()
  string(APPEND entries "    Asset{\"/${file}\", \"${type}\", {reinterpret_cast<const char*>(f${index}.data()), f${index}.size()}},\n")
  math(EXPR index "${index} + 1")
endforeach()
string(APPEND content "}  // namespace\n\nstd::span<const Asset> assets() noexcept {\n")
string(APPEND content "    static const std::array<Asset, ${index}> list{{\n${entries}    }};\n    return list;\n}\n\n}  // namespace lisbench::web\n")
file(WRITE "${OUT}.tmp" "${content}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
